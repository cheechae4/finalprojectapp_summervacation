# Supabase — 프로젝트 Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Claude — 추천 이유 문장 생성용. 없어도 앱은 동작합니다(규칙 기반 문장으로 대체).
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# 카카오맵 — 지도와 장소 검색용. 없어도 앱은 동작합니다(좌표만으로 그린 위치 관계도로 대체).
# https://developers.kakao.com 애플리케이션 > 앱 키 > JavaScript 키
# 같은 화면의 플랫폼 설정에 http://localhost:3000 과 배포 주소를 등록해야 지도가 뜹니다.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 구글 애널리틱스 (GA4). 없으면 스크립트 자체가 안 들어갑니다.
# analytics.google.com > 관리 > 데이터 스트림 에서 측정 ID(G-로 시작) 복사
NEXT_PUBLIC_GA_ID=

# 구글 태그매니저 컨테이너 ID (GTM-...). GA_ID 대신 이걸 써도 됩니다.
NEXT_PUBLIC_GTM_ID=
